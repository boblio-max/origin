# -*- mode: python ; coding: utf-8 -*-
# Origin Programming Language - Linux PyInstaller spec
#
# Build with:
#     pip install -r requirements.txt
#     pyinstaller origin.spec.linux
#
# Produces dist/origin (ELF executable). On a Raspberry Pi build host
# RPi.GPIO is included so GPIO calls hit real hardware; on generic Linux
# hosts it is excluded and the interpreter's [SIM] fallback is used.

import platform
from PyInstaller.utils.hooks import collect_submodules

block_cipher = None

on_raspberry_pi = (
    platform.machine() in ('aarch64', 'armv7l', 'armv6l')
    and platform.system() == 'Linux'
    and platform.uname().node.startswith('raspberrypi')
)

hidden = [
    'lexer',
    'parser',
    'interpreter',
    'errors',
    'classes',
    'adafruit_servokit',
    'board',
    'busio',
]
hidden += collect_submodules('adafruit_servokit')
if on_raspberry_pi:
    hidden += ['RPi', 'RPi.GPIO']

excludes = []
if not on_raspberry_pi:
    excludes = ['RPi', 'RPi.GPIO']

a = Analysis(
    ['runner.py'],
    pathex=['.'],
    binaries=[],
    datas=[('lib', 'lib')],
    hiddenimports=hidden,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='origin',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    target_arch=None,
)
